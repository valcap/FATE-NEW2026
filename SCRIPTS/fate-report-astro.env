### END OF PRODUCTION PHASE
LASTMONTHSTRING=`date +"%B" --date "$ENDOFSERVICE_YYYY-$ENDOFSERVICE_MM-$ENDOFSERVICE_DD"`
LASTMONTHDIGIT=`date +"%m" --date "$ENDOFSERVICE_YYYY-$ENDOFSERVICE_MM-$ENDOFSERVICE_DD"`
LASTYEARSTRING=`date +"%Y" --date "$ENDOFSERVICE_YYYY-$ENDOFSERVICE_MM-$ENDOFSERVICE_DD"`
STARTOFSERVICE=`date +"%d-%m-%Y" --date "$STARTOFSERVICE_YYYY-$STARTOFSERVICE_MM-$STARTOFSERVICE_DD"`
STARTOFSERVICE_STR2=`date +"%Y%m%d" --date "$STARTOFSERVICE_YYYY-$STARTOFSERVICE_MM-$STARTOFSERVICE_DD"`
STARTOFSERVICE_STR3=`date +"%Y-%m-%d" --date "$STARTOFSERVICE_YYYY-$STARTOFSERVICE_MM-$STARTOFSERVICE_DD"`
TODAYSTRING=`date +"%d-%m-%Y" --date "today"`
TODAYDOWSTRING=`date +"%a" --date "today"`
TODAYDOWSTRINGL=`date +"%A" --date "today"`
TODAYTIMESTRING=`date +"%H%M" --date "today"`
TODAYSTRING_CHILE=`TZ='America/Santiago'     date +"%d-%m-%Y" --date "now"`
TODAYDOWSTRING_CHILE=`TZ='America/Santiago'  date +"%a"       --date "now"`
TODAYDOWSTRINGL_CHILE=`TZ='America/Santiago' date +"%A"       --date "now"`
TODAYTIMESTRING_CHILE=`TZ='America/Santiago' date +"%H:%M"    --date "now"`

