# Boh settings
GG='5GG'
HH='1H'
STARTMINUTE=300            # from 19:00 LT
ENDMINUTE=960              # to 06:00 LT
TAIL=".dat"
LIMIT='0.'
# FCST_TYPE = 10min || mean
FCST_TYPE='10min'
if [ "$FCST_TYPE" != "mean" ] && [ "$FCST_TYPE" != "10min" ]; then
  echo "Errore: FCST_TYPE deve essere 'mean' o '10min'"
  exit 1
fi

# Directory settings
if [ "$FCST_TYPE" == '10min' ]; then
  DATA_ROOT_DIR=$HOME"/NEW2026/DATA/TREATED/FATE_10min_AR/AR/"$FCST_DAY_SHORT$FCST_LEN
  DATA_PERS_DIR=$HOME"/NEW2026/DATA/TREATED/FATE_10min_AR/PERSIST/"$FCST_DAY_SHORT$FCST_LEN
fi
if [ "$FCST_TYPE" == 'mean' ]; then
  DATA_ROOT_DIR=$HOME"/NEW2026/DATA/TREATED/FATE_10min_TEST_mean_next_hour/AR/"$FCST_DAY_SHORT$FCST_LEN
  DATA_PERS_DIR=$HOME"/NEW2026/DATA/TREATED/FATE_10min_TEST_mean_next_hour/PERSIST/"$FCST_DAY_SHORT$FCST_LEN
fi
FIGS_ROOT_DIR=$HOME"/NEW2026/FIGS"
